* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.h5 binary
*.nxs binary
*.sqlite binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip binary
*.woff binary
*.woff2 binary
api/tests/fixtures/semantic-golden-domain.synthetic.json text eol=lf
# shot-aligner's reference fixture, vendored byte for byte and pinned by sha256
# in its SOURCE.json: no line-ending conversion, or a Windows checkout with
# core.autocrlf=true breaks every hash. Re-vendor with
# hzdr/scripts/sync-hzdr-reference.{sh,ps1}.
api/tests/fixtures/hzdr-reference/** -text
# shot-aligner's readers, pack helpers and pack manifests, vendored byte for
# byte and pinned by sha256 in vendor/SOURCE.json; same reason. Re-vendor with
# hzdr/scripts/sync-hzdr-packs.{sh,ps1}.
api/src/damnit_api/metadata/hzdr_packs/vendor/** -text
# pnpm copies npm's deprecation notices into its lockfile, and a notice may
# hold any character, so the character check skips it.
frontend/pnpm-lock.yaml -check-characters
# Fork-owned HZDR text keeps its typographic punctuation (em dashes, arrows,
# units such as degC/um written with their symbols); vendored files and
# reference fixtures are byte-pinned by sha256. Upstream's character check
# (scripts/check-characters) skips them; it still reads every shared file.
hzdr/** -check-characters
CLAUDE.md -check-characters
api/.env*.example -check-characters
api/src/damnit_api/consumer/** -check-characters
api/src/damnit_api/metadata/hzdr_*.py -check-characters
api/src/damnit_api/metadata/hzdr_packs/** -check-characters
api/src/damnit_api/metadata/scicat.py -check-characters
api/src/damnit_api/shared/hzdr_*.py -check-characters
api/src/damnit_api/shared/flow_activity.py -check-characters
api/scripts/hzdr-* -check-characters
api/tests/fixtures/** -check-characters
api/tests/test_hzdr_* -check-characters
api/tests/test_metadata_keys.py -check-characters
frontend/apps/app/src/hzdr/** -check-characters
