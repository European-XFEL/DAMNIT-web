# Production environment template for DAMNIT-web-hzdr API.
#
# Copy to .env and fill in real values before deploying.
# Lines starting with # are comments. All DW_API_* vars use __ as the
# nested delimiter (e.g. DW_API_AUTH__MODE sets settings.auth.mode).
#
# Structured JSON logging is active automatically when DW_API_DEBUG=false.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

DW_API_DEBUG=false
DW_API_LOG_LEVEL=INFO

# Path to the DAMNIT data directory for this deployment.
# Must contain the campaign subdirectories and spool/ layout.
DW_API_DAMNIT_PATH=/data/damnit/hzdr

# SQLite database for internal API state (sessions, etc.)
DW_API_DB_PATH=/data/damnit/hzdr/dw_api.sqlite

# A long random string.  Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DW_API_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# LDAP — set server_url to enable the LDAP login form.
DW_API_AUTH__MODE=ldap
# Matches the working LabFrog LDAP config (host/DN/attrs). LabFrog also
# restricts login to the cn=fwt group (LDAP_GROUP_DN et al.); this repo's
# LDAPSettings has no group-membership gate, so that restriction is not
# enforced here — anyone who binds successfully can log in.
# Dept LDAP migration (2026): keep the DNS name (ldap.fz-rossendorf.de or
# ldap.hzdr.de — don't switch domains) but move to encrypted access: either
# ldaps:// on 636 (below), or ldap:// on 389 with DW_API_AUTH__LDAP__START_TLS=true.
DW_API_AUTH__LDAP__SERVER_URL=ldaps://ldap.fz-rossendorf.de:636
DW_API_AUTH__LDAP__BIND_DN_TEMPLATE=uid={username},ou=users,ou=FZR-NIS,ou=it,o=fsr,dc=de
DW_API_AUTH__LDAP__USER_SEARCH_BASE=ou=users,ou=FZR-NIS,ou=it,o=fsr,dc=de
DW_API_AUTH__LDAP__USER_SEARCH_FILTER=(uid={username})
DW_API_AUTH__LDAP__DISPLAY_NAME_ATTRIBUTE=displayName
DW_API_AUTH__LDAP__EMAIL_ATTRIBUTE=mail
# The dept LDAP schema doesn't define memberOf (no memberof overlay) — requesting
# it makes the whole user-attribute search fail with "invalid attribute type".
# Leave GROUPS_ATTRIBUTE empty to skip it; groups will just come back as [].
DW_API_AUTH__LDAP__GROUPS_ATTRIBUTE=
# Cert validation defaults to the system trust store (CERT_REQUIRED). Only set
# CA_CERT_FILE if the dept's LDAP cert chains to an internal CA not already
# trusted system-wide; only set VALIDATE_CERT=false to disable validation entirely
# (e.g. for a quick local test against a self-signed cert — not for production).
# DW_API_AUTH__LDAP__CA_CERT_FILE=/etc/ssl/certs/hzdr-ca.pem
# DW_API_AUTH__LDAP__VALIDATE_CERT=true
DW_API_AUTH__LDAP__TIMEOUT=5

# ---------------------------------------------------------------------------
# Metadata / source catalog
# ---------------------------------------------------------------------------

# "local" reads from hzdr_sources.json on disk (written by hzdr-hdf5-builder).
# "mongo" reads from a live MongoDB collection.
DW_API_METADATA__PROVIDER=local
DW_API_METADATA__SOURCES_FILE=/data/damnit/hzdr/hzdr_sources.json

# Curated LabFrog campaign SQLite snapshots (read-only). The Review matches page
# suggests their campaign keys when a reviewer assigns a shot. Point this at the
# curated_files/ directory produced by labfrog-sqlite-tools. Keep it next to the
# sources file above. Unset/missing => no campaign suggestions.
DW_API_METADATA__LABFROG_CURATED_DIR=/data/damnit/hzdr/curated_files

# Recorded paths (/bigdata/..., Z:/bigdata/...) are not always the ones this host
# can open. Translate them onto the mount of the same share when the API reads a
# shot's file, runs a context variable, or checks a data product; "from=to"
# prefixes, comma separated, absolute targets, longest prefix wins. A malformed
# value stops startup. Unset = paths used as recorded.
# DW_API_METADATA__PATH_MAP=/bigdata=/home/tippey/mnt/bigdata,Z:/bigdata=/home/tippey/mnt/bigdata

# MongoDB (used when PROVIDER=mongo, or for the shots side-channel).
# DW_API_METADATA__MONGO_URI=mongodb://localhost:27017
# DW_API_METADATA__MONGO_DATABASE=damnit
# DW_API_METADATA__MONGO_COLLECTION=hzdr_sources


# ---------------------------------------------------------------------------
# MediaWiki campaign links / optional live probe
# ---------------------------------------------------------------------------

DW_API_HZDR_WIKI__BASE_URL=https://athene.fz-rossendorf.de/fwk
DW_API_HZDR_WIKI__NAMESPACE=FWKT
DW_API_HZDR_WIKI__FETCH_TIMEOUT=5.0
# Optional for GET /metadata/hzdr/sources/{source_key}/wiki?fetch=true against login-required wikis.
# Keep real values only in deployed .env or instance config; never commit them.
# DW_API_HZDR_WIKI__COOKIE_HEADER=wiki_session=...; wikiUserID=...
# DW_API_HZDR_WIKI__AUTHORIZATION_HEADER=Bearer ...
# ---------------------------------------------------------------------------
# Durable spool consumer (ASAPO)
# ---------------------------------------------------------------------------

# Set ENABLED=true to start the background ASAPO consumer inside the API process.
# The consumer writes events to spool_dir/<campaign>/events.jsonl and acks
# the broker only after each write is fsync'd.
#
# BROKER_KIND selects the transport:
#   "http"  (default) — the local test harness / asapo-for-hzdr-damnit emulator
#           HTTP API. Use this only for local dev/staging against the harness.
#   "asapo" — the real DESY ASAPO SDK (RealAsapoSpoolConsumer). Requires the
#           `damnit-api[asapo]` extra installed (uv sync --extra asapo /
#           pip install 'damnit-api[asapo]'; the asapo-consumer wheel only
#           ships up to cp312). This is the production path — set BROKER_KIND
#           and the ASAPO_* values below instead of BROKER_URL.
DW_API_HZDR_SPOOL__ENABLED=false
DW_API_HZDR_SPOOL__CAMPAIGN=Solenoid_Beamline_Tests_01.2025
DW_API_HZDR_SPOOL__CONSUMER_GROUP=damnit
DW_API_HZDR_SPOOL__SPOOL_DIR=/data/damnit/hzdr/spool/asapo
DW_API_HZDR_SPOOL__POLL_INTERVAL=2.0
DW_API_HZDR_SPOOL__BATCH_SIZE=10

# --- BROKER_KIND=http (harness/emulator) --------------------------------
DW_API_HZDR_SPOOL__BROKER_KIND=http
DW_API_HZDR_SPOOL__BROKER_URL=http://asapo-broker.hzdr.de:8765

# --- BROKER_KIND=asapo (real DESY ASAPO SDK) — production path ----------
# Uncomment and fill these in, and set BROKER_KIND=asapo above, to point the
# durable spool consumer at the real ASAPO broker instead of the harness.
# DW_API_HZDR_SPOOL__BROKER_KIND=asapo
# DW_API_HZDR_SPOOL__ASAPO_ENDPOINT=asapo-broker.hzdr.de:8400
# DW_API_HZDR_SPOOL__ASAPO_BEAMTIME=<beamtime-id>
# DW_API_HZDR_SPOOL__ASAPO_DATA_SOURCE=<data-source-name>
# DW_API_HZDR_SPOOL__ASAPO_TOKEN=REPLACE_WITH_REAL_ASAPO_TOKEN
# DW_API_HZDR_SPOOL__ASAPO_STREAM=default
# DW_API_HZDR_SPOOL__ASAPO_SOURCE_PATH=auto
# DW_API_HZDR_SPOOL__ASAPO_HAS_FILESYSTEM=false
# DW_API_HZDR_SPOOL__ASAPO_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Durable spool consumer (Kafka — DAQ File Watchdog / shotcounter triggers)
# ---------------------------------------------------------------------------

# Set ENABLED=true to start the background Kafka consumer inside the API process.
# It consumes the hzdr-event-v1 trigger envelope from TOPICS with manual offset
# commit (enable_auto_commit=False) and commits only after each event is fsync'd
# to spool_dir/<campaign>/<filename>. Point the builder at that file with
# --trigger-jsonl.
DW_API_HZDR_KAFKA_SPOOL__ENABLED=false
DW_API_HZDR_KAFKA_SPOOL__BOOTSTRAP_SERVERS=kafka.hzdr.de:9092
# Topic names: see kafka-broker-docker/topics.env for the canonical registry.
# Standard topics: draco.trigger (shotcounter), planet.watchdog.events (watchdog).
DW_API_HZDR_KAFKA_SPOOL__TOPICS=["draco.trigger","planet.watchdog.events"]
DW_API_HZDR_KAFKA_SPOOL__CAMPAIGN=Solenoid_Beamline_Tests_01.2025
DW_API_HZDR_KAFKA_SPOOL__CONSUMER_GROUP=damnit-kafka
DW_API_HZDR_KAFKA_SPOOL__SPOOL_DIR=/data/damnit/hzdr/spool/kafka
DW_API_HZDR_KAFKA_SPOOL__FILENAME=trigger.jsonl
DW_API_HZDR_KAFKA_SPOOL__POLL_INTERVAL=2.0
DW_API_HZDR_KAFKA_SPOOL__POLL_TIMEOUT_MS=1000
DW_API_HZDR_KAFKA_SPOOL__BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Builder auto-trigger (rebuild the canonical NeXus + catalog on new events)
# ---------------------------------------------------------------------------
# When ENABLED, every new batch a spool consumer (ASAPO/Kafka above) writes
# signals a shared, debounced rerun of hzdr-hdf5-builder.py as a subprocess, so
# the canonical NeXus file + hzdr_sources.json stay current without a manual
# build. The builder's single-writer PID lock is preserved (subprocess isolation)
# and it reads the whole spool each run, so coalesced/duplicate triggers converge.
# Requires at least one spool consumer enabled; OUTPUT_NEXUS is required.
# The --events-jsonl / --trigger-jsonl inputs are derived from the running
# consumers' spool paths — do not set them here.
DW_API_HZDR_BUILDER__ENABLED=false
DW_API_HZDR_BUILDER__DEBOUNCE_SECONDS=10.0
# Rebuild when a LabFrog export the builds read changes (a scheduled refresh);
# checked every N seconds, 0 = off.
DW_API_HZDR_BUILDER__LABFROG_POLL_SECONDS=60
DW_API_HZDR_BUILDER__OUTPUT_NEXUS=/data/damnit/hzdr/Solenoid_Beamline_Tests_01.2025.nxs
DW_API_HZDR_BUILDER__EXPERIMENT_ID=Solenoid_Beamline_Tests_01.2025
DW_API_HZDR_BUILDER__SOURCE_KEY=hzdr-labfrog
DW_API_HZDR_BUILDER__CAMPAIGN_TIMEZONE=Europe/Berlin
DW_API_HZDR_BUILDER__MATCH_TOLERANCE_S=120.0
# false (the default since 2026-09-30, ruling A7): time-based match ranks only
# propose review candidates, and a shot_number naming exactly one shot attaches
# on the number alone (automatic shot assembly plan W6.2). true restores the
# earlier ladder, which attached a numbered trigger to a neighbouring shot by
# time.
DW_API_HZDR_BUILDER__TIME_MATCH_AUTOASSIGN=false
# Optional LabFrog reconciliation inputs and overrides:
# DW_API_HZDR_BUILDER__LABFROG_NEXUS=/data/damnit/hzdr/exports/Solenoid_Beamline_Tests_01.2025.nxs
# DW_API_HZDR_BUILDER__LABFROG_SQLITE=/data/damnit/hzdr/exports/Solenoid_Beamline_Tests_01.2025.sqlite
# DW_API_HZDR_BUILDER__SOURCES_FILE=/data/damnit/hzdr/hzdr_sources.json
# LabFrog labfrog-campaign-schedule-v1 export; routes experiment_id "unassigned"
# events by trigger time (labfrog/scripts/export_campaign_schedule.py).
# DW_API_HZDR_BUILDER__CAMPAIGN_SCHEDULE=/data/damnit/hzdr/exports/campaign-schedule.json
#
# Every campaign at once (DAMNIT readiness plan C2; recommended once the shot
# authority sends triggers as "unassigned"). Replaces OUTPUT_NEXUS,
# EXPERIMENT_ID and LABFROG_* above (refused together with them; SOURCE_KEY is
# ignored): each run builds every campaign in CAMPAIGNS, every campaign with a
# spool folder, every campaign an unassigned trigger resolves to, and the
# _unassigned bucket, to <OUTPUT_ROOT>/<campaign>/<campaign>.nxs, each finding
# its LabFrog export as <CURATED_ROOT>/<campaign>/<campaign>.sqlite. All merge
# into one catalog (SOURCES_FILE, default <OUTPUT_ROOT>/hzdr_sources.json),
# which DW_API_METADATA__SOURCES_FILE must name so the API serves every campaign
# and Review matches rulings reach every build. Only the exports of CAMPAIGNS
# (and of campaigns with a spool folder) may claim unassigned triggers: LabFrog
# numbers restart every campaign, so list a campaign only while it takes shots.
# DW_API_HZDR_BUILDER__OUTPUT_ROOT=/data/damnit/hzdr
# DW_API_HZDR_BUILDER__CURATED_ROOT=/home/tippey/labfrog-sqlite-tools-repo/curated_files
# DW_API_HZDR_BUILDER__CAMPAIGNS=["Beamline_radbio_2026"]
#
# DW_API_HZDR_BUILDER__PYTHON_EXECUTABLE=  # defaults to the API's interpreter
# DW_API_HZDR_BUILDER__SCRIPT_PATH=        # defaults to the bundled builder script
# DW_API_HZDR_BUILDER__EXTRA_ARGS=[]       # any additional builder CLI flags
#
# Shot containers (campaign output phase 3, hzdr/docs/plans/container-writer.md):
# start api/scripts/hzdr-container-worker.py before and after each build. It
# writes <campaign folder>/shots/<YYYYMMDD>_<shot_number>.nxs outside the
# campaign lock, reads raws through DW_API_METADATA__PATH_MAP, and logs to
# .hzdr-container-worker.log beside the output. Off by default.
# DW_API_HZDR_BUILDER__CONTAINERS_ENABLED=false
# With OUTPUT_ROOT, also convert the _unassigned bucket (its shots are converted
# again once a campaign claims them, so off by default).
# DW_API_HZDR_BUILDER__CONTAINERS_INCLUDE_UNASSIGNED=false
# DW_API_HZDR_BUILDER__CONTAINER_WORKER_SCRIPT=  # defaults to the bundled worker
# NeXus validation gate (phase 5): a Python with nexus-design-studio + pynxtools
# (NDS's own environment). Set, every build's output is validated after its
# container worker; results in <campaign folder>/.validation.json and
# .hzdr-validation.log. Empty: off.
# DW_API_HZDR_BUILDER__VALIDATION_PYTHON=/home/tippey/nexus-design-studio/.venv/bin/python
# DW_API_HZDR_BUILDER__VALIDATION_SCRIPT=  # defaults to the bundled hzdr-nexus-validate.py

# ---------------------------------------------------------------------------
# Flow monitor health probes (GET /config/health)
# ---------------------------------------------------------------------------

DW_API_HZDR_HEALTH__ASAPO_STATUS_URL=http://asapo-broker.hzdr.de:8765/api/status
DW_API_HZDR_HEALTH__KAFKA_BOOTSTRAP=kafka.hzdr.de:9092
DW_API_HZDR_HEALTH__MONGO_URI=mongodb://localhost:27017
DW_API_HZDR_HEALTH__TIMEOUT=2.0

# ---------------------------------------------------------------------------
# Flow monitor Live-mode ASAPO stream activity (GET /config/flow-activity)
# ---------------------------------------------------------------------------
# Optional: shows real ASAPO stream sizes in the flow monitor's Live view.
# Requires the `damnit-api[asapo]` extra. Leave unset to degrade gracefully
# (available=false) — Kafka offset counts and spool-file line counts still work
# without this.
# DW_API_HZDR_ASAPO_ACTIVITY__ENDPOINT=asapo-broker.hzdr.de:8400
# DW_API_HZDR_ASAPO_ACTIVITY__BEAMTIME=<beamtime-id>
# DW_API_HZDR_ASAPO_ACTIVITY__DATA_SOURCE=<data-source-name>
# DW_API_HZDR_ASAPO_ACTIVITY__TOKEN=REPLACE_WITH_REAL_ASAPO_TOKEN
# DW_API_HZDR_ASAPO_ACTIVITY__SOURCE_PATH=auto
# DW_API_HZDR_ASAPO_ACTIVITY__HAS_FILESYSTEM=false
# DW_API_HZDR_ASAPO_ACTIVITY__TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# SciCat registration (DAMNIT publishes coherent campaign snapshots, then updates one PID)
# ---------------------------------------------------------------------------
# When ENABLED, the builder's post-step POSTs the built NeXus file *path* +
# assembled scientificMetadata to the scicat_plugin HTTP service, and stores the
# returned dataset PID in the source catalog (surfaced by GET .../scicat). Registration is best-effort: a failure never fails a build,
# and unchanged metadata/file inventories skip the re-POST. Review may still be
# in progress: published metadata records match/review coverage. The SciCat
# URL/token live in the plugin's own env — never here; DAMNIT only knows the
# plugin's HTTP address and service key. Direct Watchdog SciCat push stays off.
# Legacy from-json/push are available only when deliberately selected.
DW_API_HZDR_SCICAT__ENABLED=false
DW_API_HZDR_SCICAT__PLUGIN_URL=http://127.0.0.1:5001
DW_API_HZDR_SCICAT__ENDPOINT=publish
DW_API_HZDR_SCICAT__API_KEY=
DW_API_HZDR_SCICAT__PUBLISHER=damnit
DW_API_HZDR_SCICAT__TIMEOUT=120.0
DW_API_HZDR_SCICAT__INSTRUMENT_ID=DRACO
DW_API_HZDR_SCICAT__DATASET_TYPE=raw
# Optional ownership overrides (the plugin's env supplies defaults if unset):
# DW_API_HZDR_SCICAT__OWNER_GROUP=fwkt
# DW_API_HZDR_SCICAT__ACCESS_GROUPS=["fwkt","hzdr"]
# Public SciCat web UI base, used only to build a clickable dataset link:
# DW_API_HZDR_SCICAT__FRONTEND_URL=https://scicat.hzdr.de

# Opt-in managed publishing: deploy the plugin's /scicat/publish contract and
# persistent journal first. Legacy PIDs require reviewed migration; changing
# this option does not adopt or delete historical records.
# Only verified SciCat catalogue IDs belong here. INSTRUMENT_ID remains a
# descriptive legacy value in managed mode; campaign slugs are not proposal IDs.
# DW_API_HZDR_SCICAT__CATALOGUE_INSTRUMENT_ID=
# DW_API_HZDR_SCICAT__CATALOGUE_PROPOSAL_ID=
# DW_API_HZDR_SCICAT__CATALOGUE_SAMPLE_ID=
# Optional existing overview image; relative paths are inside each campaign folder.
# DW_API_HZDR_SCICAT__PREVIEW_PATH=overview.png
# DW_API_HZDR_SCICAT__PREVIEW_CAPTION=Campaign overview
# Preview creation/replacement additionally needs the plugin account's attachment
# permissions, including v4 PATCH; leave PREVIEW_PATH unset until verified.

# ---------------------------------------------------------------------------
# Fixed laser-system constants
# ---------------------------------------------------------------------------
# The metadata.laser.* keys that describe the laser rather than a shot, and
# that therefore no producer event carries: central wavelength, repetition
# rate, polarization, system name (hzdr/docs/standards-alignment.md §3.3.1).
# State them once here and the builder fills them into /entry/instrument/laser,
# marking each filled dataset damnit_source="config". A producer value always
# wins; leave a field unset and nothing is written for it.
# Keys are bare registry names in registry units: WAVELENGTH in nm,
# REPETITION_RATE in Hz. POLARIZATION must be one of p, s, horizontal,
# vertical, linear, circular, circular_left, circular_right, elliptical,
# unpolarized (LASER_POLARIZATION_VALUES).
# DW_API_HZDR_LASER__SYSTEM=DRACO
# DW_API_HZDR_LASER__WAVELENGTH=800
# DW_API_HZDR_LASER__REPETITION_RATE=1.0
# DW_API_HZDR_LASER__POLARIZATION=p

# ---------------------------------------------------------------------------
# Uvicorn
# ---------------------------------------------------------------------------

DW_API_UVICORN__HOST=127.0.0.1
DW_API_UVICORN__PORT=8000
DW_API_UVICORN__RELOAD=false
# SSL — uncomment and point at real cert/key files for HTTPS.
# DW_API_UVICORN__SSL_CERTFILE=/etc/ssl/certs/damnit.crt
# DW_API_UVICORN__SSL_KEYFILE=/etc/ssl/private/damnit.key

# ---------------------------------------------------------------------------
# Deployment terminology (shown in UI)
# ---------------------------------------------------------------------------

DW_API_DEPLOYMENT__PROFILE=hzdr
DW_API_DEPLOYMENT__TERMINOLOGY__IDENTITY_NAME=source
DW_API_DEPLOYMENT__TERMINOLOGY__IDENTITY_NAME_PLURAL=sources
DW_API_DEPLOYMENT__TERMINOLOGY__IDENTITY_LABEL=Source
DW_API_DEPLOYMENT__TERMINOLOGY__IDENTITY_LABEL_PLURAL=Sources
DW_API_DEPLOYMENT__TERMINOLOGY__COLLECTION_LABEL=HZDR sources
DW_API_DEPLOYMENT__TERMINOLOGY__USES_PROPOSALS=false
DW_API_DEPLOYMENT__TERMINOLOGY__USES_MYMDC=false
