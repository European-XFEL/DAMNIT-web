{
  "name": "damnit-frontend",
  "version": "0.2.0",
  "description": "",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "lint:prettier": "pnpm -r lint:prettier",
    "lint:eslint": "pnpm -r lint:eslint",
    "lint:tsc": "pnpm -r lint:tsc",
    "test": "pnpm -r test",
    "test:node": "pnpm -r test:node",
    "test:browser": "pnpm -r test:browser",
    "check:nginx": "bash nginx/check.sh",
    "integration": "pnpm --filter @damnit-frontend/app exec playwright test -c playwright.integration.config.ts",
    "integration:ui": "pnpm --filter @damnit-frontend/app exec playwright test -c playwright.integration.config.ts --ui",
    "integration:report": "pnpm --filter @damnit-frontend/app exec playwright show-report",
    "e2e:app": "pnpm --filter @damnit-frontend/app exec playwright test -c playwright.e2e.config.ts",
    "e2e:site": "pnpm --filter @damnit-frontend/site exec playwright test",
    "e2e:demo": "pnpm --filter @damnit-frontend/demo exec playwright test",
    "e2e:report": "pnpm --filter @damnit-frontend/app exec playwright show-report",
    "playwright:install": "pnpm --filter @damnit-frontend/testing exec playwright install chromium",
    "dev:app": "pnpm --filter @damnit-frontend/app dev",
    "build:app": "pnpm --filter @damnit-frontend/app build",
    "preview:app": "pnpm --filter @damnit-frontend/app preview",
    "dev:site": "pnpm --filter @damnit-frontend/site dev",
    "build:site": "pnpm --filter @damnit-frontend/site build",
    "preview:site": "pnpm --filter @damnit-frontend/site preview",
    "dev:demo": "pnpm --filter @damnit-frontend/demo dev",
    "build:demo": "pnpm --filter @damnit-frontend/demo build",
    "preview:demo": "pnpm --filter @damnit-frontend/demo preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@damnit-frontend/config": "workspace:*",
    "eslint": "catalog:linting",
    "prettier": "catalog:linting",
    "typescript": "catalog:tooling"
  }
}
